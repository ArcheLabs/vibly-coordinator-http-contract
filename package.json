{
  "name": "@vibly-ai/coordinator-http-contract",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./types": {
      "types": "./dist/generated/types.d.ts",
      "default": "./dist/generated/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "scripts": {
    "gen": "openapi-typescript ./openapi.json --output ./src/generated/types.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:types": "node scripts/verify-types.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
